	(text "+5V_HUB: the Pi's VBUS: the hub, the plot bed board\n(RAW): ~0.1-0.3 A of the Pi 4's\n1.2 A (all its ports together). +5V_TOOL_IN: MP_Buck1:\nthe tool (U1006, F1001), the bed and\n+5V_SW (U956/U957); never tied to +5V_HUB."
		(exclude_from_sim no)
		(at 22.86 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d9426d0d-14d8-4c70-b641-7d180e4f4463")
	)
	(text "GROUND"
		(exclude_from_sim no)
		(at 106.68 213.36 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9c801ee6-c726-46ed-bd22-6033fe60bbb5")
	)
	(text "One GND: the Pi's (USB), the 9 V's, the tool's\nreturn, the link's. The tool's current stays\non this board (U1007 to J1001); the link's\nGND carries only the plot bed board."
		(exclude_from_sim no)
		(at 106.68 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bc07be2b-d5a0-4a7a-9442-81c2d0e7c19c")
	)
	(text "ON ITS OWN"
		(exclude_from_sim no)
		(at 190.5 213.36 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "07139017-1312-4be8-8f5c-52bc1ccbca35")
	)
	(text "Pi + 9 V, J1002 out: the hub and its ports\nwork, the tool stays off (R1002). The plot\nbed board alone: its own USB-C, J957 out."
		(exclude_from_sim no)
		(at 190.5 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d830e99d-8143-426a-93dc-3e45a45d3d45")
	)
	(text "THE TOOL (PI ZERO)"
		(exclude_from_sim no)
		(at 274.32 213.36 0)
		(effects
