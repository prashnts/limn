	)
	(text "Stranded (patch) cable, through\nthe cable chain. Analog only.\n\nPad: wire = signal\n1: white-orange = E+ (3V3)\n8: orange = E- (GND)\n3: white-blue = S+ (SIG_P)\n4: blue = S- (SIG_N)\n5: white-green = TOOL_ID\n2, 6, 7: white-brown, green, brown\n     = spare (were the QRE's)\n\nAll DC.\nHead end: J951 = pads 1, 3, 4, 8;\nJ954 = pad 5."
		(exclude_from_sim no)
		(at 104.14 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "22810ad0-a786-43d9-9878-812509ef75bb")
	)
	(text "CAT6 #2: TOOL 5 V + USB"
		(exclude_from_sim no)
		(at 104.14 160.02 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "31685f40-76b9-4d08-abc6-f3808a69e364")
	)
	(text "Pad: wire = signal\n1-3: white-orange, -green, -brown\n     = +5V_TOOL\n6-8: orange, green, brown = GND\n4: white-blue = USB D+\n5: blue = USB D-\n\nFrom the hub board's J1003\n(sheet Hub board): it passes\nthis board by."
		(exclude_from_sim no)
		(at 104.14 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "45970c4f-0a4a-46a9-ab05-947f3f8f6443")
	)
