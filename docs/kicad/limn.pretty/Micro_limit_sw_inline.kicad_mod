(footprint "Micro_limit_sw_inline"
	(version 20241229)
	(generator "limn_gen")
	(layer "F.Cu")
	(descr "Inline micro limit switch (the key's switch), 5.8 x 10 mm; its two tabs in slots, from the user's model: check against the part")
	(property "Reference" "REF**" (at 0 -6.2 0) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.150))))
	(property "Value" "Micro_limit_sw_inline" (at 0 6.50 0) (layer "F.Fab") (effects (font (size 1.0 1.0) (thickness 0.150))))
	(attr through_hole)
	(fp_rect (start -2.9 -5.0) (end 2.9 5.0) (stroke (width 0.12) (type solid)) (fill no) (layer "F.SilkS"))
	(fp_rect (start -2.9 -5.0) (end 2.9 5.0) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_rect (start -3.15 -5.25) (end 3.15 5.25) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_text user "key" (at -1.0 0 0) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.090))))
	(pad "1" thru_hole oval (at 1.8 3.1) (size 1.2 2.0) (drill oval 0.6 1.4) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole oval (at 1.8 0) (size 1.2 2.0) (drill oval 0.6 1.4) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/limn.3dshapes/Micro_limit_sw_inline.stpZ" (offset (xyz 0 0 2.15)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
