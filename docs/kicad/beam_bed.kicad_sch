	(text "AO3400: logic level, the 100k holds it off through a reset.\n~35 mA pulsed from BED_PWR (5 V): (5 - 1.3) / 100R.\nOn minus off at a few kHz cancels room light.\nX and Y on their own pins: only one lit at a time,\nso the X LED can't leak into the Y phototransistor."
		(exclude_from_sim no)
		(at 210.82 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ad4e4173-8fa6-492d-8f9b-d3028bc6e012")
	)
