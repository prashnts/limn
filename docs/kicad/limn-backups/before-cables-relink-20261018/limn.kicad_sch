	(text "USB-C PD charger: 12 V (motion,\nswitched), 9 V (the 5 V bucks),\nthe Pi's port. Rails: +12V,\n+7V5_ZK, +9V, +5V_LED, +5V_TOOL."
		(exclude_from_sim no)
		(at 27.94 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "907fdbdd-aabf-476e-ad4d-e65adb713a66")
	)
	(text "Pi 4: USB to every MCU and the\ncameras (an FE1.1s hub, planned),\nI2C1 to the tool dock."
		(exclude_from_sim no)
		(at 116.84 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "27a85a9c-2f1c-47fd-bfaf-ff75bebf697e")
	)
	(text "Melzi v2.0: motors A, B, Z, K,\nthe endstops, the EXT header,\nthe probe pin (PROBE_A4)."
		(exclude_from_sim no)
		(at 116.84 111.76 0)
		(effects
