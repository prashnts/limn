			)
			(justify left top)
		)
		(uuid "23962374-aee8-4e0d-8aa2-9da7503023f1")
	)
	(text "9 V -> U955 (+5V_BUCK1, always on) -> D952 -> RAW (+5V_PM): the board;\n-> U953 + F951 -> +5V_TOOL on CAT6 #2. USB carries data only (VBUS\nnot wired). The tool's 2 A never on the GND rails. +3V3_PH = E+."
		(exclude_from_sim no)
		(at 22.86 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d5c4cdf0-d14d-462f-8661-2414a8b4c898")
	)
	(text "THE BRIDGE"
