	(text "The plot bed's touch line (open collector,\nsheet Plot bed): its pull-up here at the\nMelzi. endstop_pin: ^PA4 (or this 10k), no !.\nHigh = triggered."
		(exclude_from_sim no)
		(at 281.94 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
