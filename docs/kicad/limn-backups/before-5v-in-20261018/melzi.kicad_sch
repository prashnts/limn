		(uuid "868a8480-162d-42eb-a775-b1c6cfd906ec")
	)
	(text "EXT header (JP16): A2 = ^PA2 K endstop, A3 = PA3 BLTouch\ncontrol, A4 = ^PA4 the probe pin. A1, SDA, SCL, TX, RX unused."
		(exclude_from_sim no)
		(at 101.6 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
