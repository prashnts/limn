	(text "CAT6 UTP, 0.6-1 m"
		(exclude_from_sim no)
		(at 104.14 101.6 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3d11ff25-0c4a-462f-b3e5-3dbcb9b2875d")
	)
	(text "Stranded (patch) cable, through\nthe cable chain. Analog only.\n\nPad: wire = signal\n1: white-orange = E+ (3V3)\n8: orange = E- (GND)\n2: white-blue = S+ (SIG_P)\n3: blue = S- (SIG_N)\n4: white-green = TOOL_ID\n7: green = GND (board end only)\n5: white-brown = LED anode\n6: brown = LED return (GND)\n\nID: DC, read unpowered. LED: on/off\nonly, no PWM (in band for the ADC)."
		(exclude_from_sim no)
		(at 104.14 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7ef3302e-8d34-496c-907b-5b8420443935")
	)
