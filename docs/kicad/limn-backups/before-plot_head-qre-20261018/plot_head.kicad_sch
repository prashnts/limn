	(text "The bridge closes here: 32 AWG twisted from\neach gauge, slack loops, tied down on HS.\nTOOL_ID: the coupling's ID contact. Green (7):\nnot connected here, GND at the board only."
		(exclude_from_sim no)
		(at 22.86 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c8402816-868e-4a4f-97db-b103cb98722d")
	)
