	)
	(text "Stranded (patch) cable, through\nthe cable chain. Analog only.\n\nPad: wire = signal\n1: white-orange = E+ (3V3)\n8: orange = E- (GND)\n3: white-blue = S+ (SIG_P)\n4: blue = S- (SIG_N)\n5: white-green = TOOL_ID\n6: green = QRE_OUT\n2: white-brown = QRE 3V3\n7: brown = QRE GND\n\nAll DC: the QRE's LED on steady,\nno pulsing (kHz is in band for the ADC)."
		(exclude_from_sim no)
		(at 104.14 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "868cbee3-80f8-4499-9455-77bde91f69de")
	)
