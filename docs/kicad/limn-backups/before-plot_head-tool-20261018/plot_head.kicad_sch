	(text "Through the cable chain. Stranded\n(patch) cable: solid core cracks.\n\nPad: wire = signal\n1: white-orange = E+ (3V3)\n8: orange = E- (GND)\n2: white-blue = S+ (SIG_P)\n3: blue = S- (SIG_N)\n4: white-green = NTC\n7: green = NTC return\n5: white-brown = spare\n6: brown = spare\n\nSpare pair: GND at the board,\ncut and insulated at the cell."
		(exclude_from_sim no)
		(at 106.68 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8b2c70ea-54e0-49a8-a24b-952395a6c3b8")
	)
