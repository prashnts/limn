	(text "The bridge closes here: 32 AWG twisted from\neach gauge, slack loops, tied down on HS.\nTOOL_ID: the coupling's ID contact. U954 on\nthe toolhead's back, 1-2 mm from a white label\non the tool. 3V3 and GND on their own pair."
		(exclude_from_sim no)
		(at 22.86 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bb4f160e-454c-4c3a-b284-819ddf8d3ab4")
	)
	(rectangle
		(start 15.24 17.78)
		(end 96.52 157.48)
		(stroke
			(width 0.254)
			(type solid)
			(color 72 72 72 1)
		)
		(fill
			(type none)
		)
		(uuid "8c359b2b-3032-455b-8a24-2d69a301d049")
	)
	(text "On the cell (Rider-HS)"
		(exclude_from_sim no)
		(at 16.51 19.05 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "204e72b7-c0af-438b-8add-830ee494a4b6")
	)
	(text "CAT6 UTP, 0.6-1 m"
		(exclude_from_sim no)
		(at 104.14 101.6 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8fb5022f-92af-4c28-9138-2fef8dfde323")
	)
	(text "Stranded (patch) cable, through\nthe cable chain. Analog only.\n\nPad: wire = signal\n1: white-orange = E+ (3V3)\n8: orange = E- (GND)\n3: white-blue = S+ (SIG_P)\n4: blue = S- (SIG_N)\n5: white-green = TOOL_ID\n6: green = QRE_OUT\n2: white-brown = QRE 3V3\n7: brown = QRE GND\n\nAll DC: the QRE's LED on steady,\nno pulsing (kHz is in band for the ADC)."
		(exclude_from_sim no)
		(at 104.14 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "617ef62e-9113-4cd1-911b-94929a238e64")
	)
