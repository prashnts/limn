	(text "GP6 high = the NPN conducts = the Melzi pin low = OK. A touch, a dead\nMCU (100k holds the base low) or a cut wire: the Melzi's pull-up\n(R401, sheet Melzi) wins = triggered."
		(exclude_from_sim no)
		(at 317.5 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3720bd65-31ae-460f-9d17-bce47e1e5fb7")
	)
