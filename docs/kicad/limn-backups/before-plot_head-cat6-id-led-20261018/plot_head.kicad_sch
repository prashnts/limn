			)
			(justify left top)
		)
		(uuid "0ea90d2b-f25a-426e-b0ef-810cae2244d5")
	)
	(text "The board: USB from the Pi (its 3V3 = +3V3_PH, the bridge's E+).\nThe tool: MP_Buck1 (+5V_BUCK1) through U953 and F951 to\n+5V_TOOL. Grounds: the one star point; R960 on the CTRL line."
		(exclude_from_sim no)
		(at 22.86 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7df66f69-a150-48c5-9e9b-d5e6f5960906")
	)
	(text "THE BRIDGE"
		(exclude_from_sim no)
		(at 110.49 190.5 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3c56f8e8-fa20-4300-b310-a26672add782")
	)
	(text "One full bridge, closed on the pads on HS: 4 wires in the CAT6\n(orange = E, blue = S). Sign and grams on the bench. No NTC: the\ncell is below the steppers, nothing warm nearby."
		(exclude_from_sim no)
		(at 110.49 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "18f97326-7efb-4a7a-a342-3c766de9e43e")
	)
	(text "THE ADC"
