	(text "Stranded (patch) cable, through\nthe cable chain. Analog only.\n\nPad: wire = signal\n1: white-orange = E+ (3V3)\n8: orange = E- (GND)\n2: white-blue = S+ (SIG_P)\n3: blue = S- (SIG_N)\n4-7: green, brown pairs = spare\n(GND at the board end; free\nfor later use)"
		(exclude_from_sim no)
		(at 104.14 106.68 0)
