	(text "The bridge closes here: 32 AWG twisted from\neach gauge, slack loops, tied down on HS.\nTOOL_ID: the coupling's ID contact. U954 on\nthe toolhead's back, 1-2 mm from a white label\non the tool. 3V3 and GND on their own pair."
		(exclude_from_sim no)
		(at 22.86 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b5de2487-ec87-462e-893a-df9cf27d3954")
	)
	(rectangle
		(start 15.24 17.78)
		(end 96.52 157.48)
		(stroke
			(width 0.254)
			(type solid)
			(color 72 72 72 1)
		)
		(fill
			(type none)
		)
		(uuid "154038c2-1b97-4535-b1e7-d64144a725f9")
	)
	(text "On the cell (Rider-HS)"
		(exclude_from_sim no)
		(at 16.51 19.05 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "fb89ed40-2a5e-4398-b056-0502ecff39b5")
	)
	(text "CAT6 UTP, 0.6-1 m"
		(exclude_from_sim no)
		(at 104.14 101.6 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "64192fda-f082-4e65-9ef5-625b3d305a08")
	)
	(text "Stranded (patch) cable, through\nthe cable chain. Analog only.\n\nPad: wire = signal\n1: white-orange = E+ (3V3)\n8: orange = E- (GND)\n3: white-blue = S+ (SIG_P)\n4: blue = S- (SIG_N)\n5: white-green = TOOL_ID\n6: green = QRE_OUT\n2: white-brown = QRE 3V3\n7: brown = QRE GND\n\nAll DC: the QRE's LED on steady,\nno pulsing (kHz is in band for the ADC)."
		(exclude_from_sim no)
		(at 104.14 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c4802aee-bbc5-4663-84ad-755add696454")
	)
