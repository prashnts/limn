		(uuid "3e4d6b2f-cbcb-4706-9503-7b5f90ba6c9f")
	)
	(text "Pi 4: USB to every MCU and the\ncameras (an FE1.1s hub, planned),\nI2C1 to the tool dock."
		(exclude_from_sim no)
		(at 116.84 53.34 0)
		(effects
