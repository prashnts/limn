	(text "Cut at this end, soldered to the breakout;\nthe plug in the hub board's USB-C (U1007).\nR502: Rd on CC, so a PC's USB-C port turns\nVBUS on (a test straight on the computer).\nShield: open here (grounded at the plug)."
		(exclude_from_sim no)
		(at 355.6 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b6c4c1d-764b-4974-81bc-1d6f75b1fc95")
	)
	(text "THE HARNESS, FROM THIS BREAKOUT"
		(exclude_from_sim no)
		(at 355.6 124.46 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b7a067c9-1f28-4dba-8cc1-c575edc0cebb")
	)
	(text "USB-C cable: VBUS on 13-15, GND on the GND pads, D+/D- on 9/10\n(untwisted <= 1 cm), CC: R502. To the hub board.\nCAT6 UTP 32 AWG, MX1.25 at LIT (J952): orange E+ (white) / E-,\nblue S+ (white) / S-, green the ID (white) + GND (its\nreturn), brown spare (open at both ends).\nRibbon 26 AWG to the Melzi: K's 4 wires, ENDSTOP_K, GND."
		(exclude_from_sim no)
		(at 355.6 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ab392467-f0fd-44e7-be1e-1a278605b529")
	)
